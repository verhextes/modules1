--1
SELECT name, unit_price
FROM products WHERE unit_price > 10000
ORDER BY unit_price DESC LIMIT 4;
--2
SELECT id, name, city, capacity
FROM warehouses WHERE capacity >= 3000;
--3
SELECT first_name, last_name, hire_date
FROM employees
ORDER BY hire_date DESC;
--4
SELECT first_name, last_name, salary
FROM employees
WHERE warehouse_id = 1 AND job_title = 'Кладовщик';
--5
SELECT id, name, country
FROM suppliers
WHERE country IN ('Германия', 'Россия');
--6
SELECT id, sku, name
FROM products
WHERE sku LIKE '%ST%';
--7
SELECT id, name, country
FROM suppliers
WHERE rating IS NULL;
--8
SELECT id, product_id, quantity, movement_date
FROM movements
WHERE movement_type = 'out'
AND movement_date BETWEEN '2026-10-01' AND '2026-10-10'
ORDER BY movement_date;
--9
SELECT DISTINCT job_title 
FROM employees ORDER BY job_title;
--10
SELECT name, unit_price
FROM products
ORDER BY unit_price
LIMIT 3 OFFSET 3;
#12
SELECT p.name AS product, s.name AS supplier, s.country
FROM products p
JOIN suppliers s ON p.supplier_id = s.id;

#13
SELECT c.name AS category, COUNT(p.id) AS products_count
FROM categories c
LEFT JOIN products p ON c.id = p.category_id
GROUP BY c.id, c.name;
#14
SELECT s.name AS supplier, COUNT(p.id) AS products_count
FROM suppliers s
LEFT JOIN products p ON s.id = p.supplier_id
GROUP BY s.id, s.name;

#15
SELECT w.name AS warehouse, p.name AS product, s.quantity
FROM stock s
JOIN warehouses w ON s.warehouse_id = w.id
JOIN products p ON s.product_id = p.id
WHERE w.name = 'Южный';

#16
SELECT e.first_name, e.last_name, w.name AS warehouse
FROM employees e
LEFT JOIN warehouses w ON e.warehouse_id = w.id;

#17
SELECT e.first_name, e.last_name, m.first_name AS manager_first_name, m.last_name AS manager_last_name
FROM employees e
LEFT JOIN employees m ON e.manager_id = m.id;

#18
SELECT p.id, p.name
FROM products p
LEFT JOIN stock s ON p.id = s.product_id
WHERE s.id IS NULL;

#20
SELECT p.name AS product, c.name AS category, s.name AS supplier
FROM products p
JOIN categories c ON p.category_id = c.id
JOIN suppliers s ON p.supplier_id = s.id
WHERE c.name IN ('Электроника', 'Мебель');


#21
SELECT c.name AS category, COUNT(p.id) AS products_count, AVG(p.unit_price) AS avg_price
FROM categories c
JOIN products p ON c.id = p.category_id
GROUP BY c.id, c.name;

#22
SELECT c.name AS category, AVG(p.unit_price) AS avg_price
FROM categories c
JOIN products p ON c.id = p.category_id
GROUP BY c.id, c.name
HAVING AVG(p.unit_price) > 5000;
#23
SELECT p.name AS product, SUM(s.quantity) AS total_quantity
FROM products p
JOIN stock s ON p.id = s.product_id
GROUP BY p.id, p.name
ORDER BY total_quantity DESC, p.id ASC;

#24
SELECT w.name AS warehouse, SUM(s.quantity * p.unit_price) AS stock_value
FROM stock s
JOIN warehouses w ON s.warehouse_id = w.id
JOIN products p ON s.product_id = p.id
GROUP BY w.id, w.name;
#27
SELECT 
 job_title, 
 COUNT(*) AS employees_count, 
 AVG(salary) AS avg_salary
FROM employees
GROUP BY job_title
ORDER BY employees_count DESC, job_title ASC;
#28
SELECT w.name AS warehouse, SUM(s.quantity) AS total_quantity
FROM stock s
JOIN warehouses w ON s.warehouse_id = w.id
GROUP BY w.id, w.name
HAVING SUM(s.quantity) > 500;

#29
SELECT s.name AS supplier, COUNT(p.id) AS products_count
FROM suppliers s
JOIN products p ON s.id = p.supplier_id
GROUP BY s.id, s.name
ORDER BY products_count DESC, s.name ASC
LIMIT 3;

#30
SELECT 
    w.name AS warehouse, 
    MIN(m.movement_date) AS first_date, 
    MAX(m.movement_date) AS last_date, 
    COUNT(*) AS movements_count
FROM movements m
JOIN warehouses w ON m.warehouse_id = w.id
GROUP BY w.id, w.name;
