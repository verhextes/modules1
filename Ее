-- ============================================================
-- ЗАДАНИЕ 12. CASE и условная логика
-- ============================================================
SELECT
    o.id,
    o.order_date,
    o.total_amount,
    CASE
        WHEN o.total_amount > 5000 AND o.status IN ('new','paid') THEN 'Срочный'
        WHEN o.total_amount BETWEEN 1000 AND 5000                  THEN 'Обычный'
        ELSE 'Мелкий'
    END AS priority
FROM orders o
ORDER BY
    CASE
        WHEN o.total_amount > 5000 AND o.status IN ('new','paid') THEN 1
        WHEN o.total_amount BETWEEN 1000 AND 5000                  THEN 2
        ELSE 3
    END,
    o.total_amount;


