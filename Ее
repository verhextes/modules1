-- ============================================================
-- ЗАДАНИЕ 1. Многотабличный JOIN и фильтрация
-- ============================================================
SELECT
    o.id              AS order_id,
    o.order_date,
    c.full_name       AS customer_name,
    c.city,
    o.total_amount,
    COUNT(oi.id)      AS items_count
FROM orders o
JOIN customers c   ON c.id = o.customer_id
JOIN order_items oi ON oi.order_id = o.id
WHERE o.status = 'delivered'
  AND o.order_date >= DATE_SUB(CURDATE(), INTERVAL 6 MONTH)
GROUP BY o.id, o.order_date, c.full_name, c.city, o.total_amount
ORDER BY o.total_amount DESC;


-- ============================================================
-- ЗАДАНИЕ 2. LEFT JOIN и поиск «потерянных» записей
-- ============================================================
SELECT
    b.title,
    a.full_name AS author,
    cat.name    AS category,
    b.price
FROM books b
JOIN authors a      ON a.id = b.author_id
JOIN categories cat ON cat.id = b.category_id
LEFT JOIN order_items oi ON oi.book_id = b.id
WHERE oi.id IS NULL
ORDER BY b.price DESC;


-- ============================================================
-- ЗАДАНИЕ 3. Агрегация с GROUP BY и HAVING
-- ============================================================
SELECT
    a.full_name,
    COUNT(b.id)    AS books_count,
    SUM(b.stock)   AS total_stock
FROM authors a
JOIN books b ON b.author_id = a.id
GROUP BY a.id, a.full_name
HAVING COUNT(b.id) >= 3
   AND SUM(b.stock) > 50;


-- ============================================================
-- ЗАДАНИЕ 4. Подзапрос в WHERE
-- ============================================================
SELECT
    c.full_name,
    c.email,
    SUM(o.total_amount) AS total_spent
FROM customers c
JOIN orders o ON o.customer_id = c.id
GROUP BY c.id, c.full_name, c.email
HAVING SUM(o.total_amount) > (
    SELECT AVG(total_amount) FROM orders
);


-- ============================================================
-- ЗАДАНИЕ 5. Коррелированный подзапрос
-- ============================================================
SELECT
    cat.name AS category,
    (
        SELECT b2.title
        FROM books b2
        WHERE b2.category_id = cat.id
        ORDER BY b2.price DESC
        LIMIT 1
    ) AS most_expensive_book
FROM categories cat;


-- ============================================================
-- ЗАДАНИЕ 6. JOIN + агрегация + сортировка
-- ============================================================
SELECT
    c.city,
    COUNT(DISTINCT c.id)  AS unique_customers,
    COUNT(o.id)           AS orders_count,
    SUM(o.total_amount)   AS revenue
FROM customers c
JOIN orders o ON o.customer_id = c.id
WHERE o.status = 'delivered'
GROUP BY c.city
HAVING SUM(o.total_amount) > 10000
ORDER BY revenue DESC;


-- ============================================================
-- ЗАДАНИЕ 7. Многоуровневый подзапрос / CTE
-- ============================================================
WITH city_book_sales AS (
    SELECT
        c.city,
        b.id   AS book_id,
        b.title,
        COUNT(DISTINCT o.id) AS orders_count
    FROM orders o
    JOIN customers c   ON c.id = o.customer_id
    JOIN order_items oi ON oi.order_id = o.id
    JOIN books b       ON b.id = oi.book_id
    GROUP BY c.city, b.id, b.title
),
ranked AS (
    SELECT
        city,
        title,
        orders_count,
        ROW_NUMBER() OVER (PARTITION BY city ORDER BY orders_count DESC) AS rn
    FROM city_book_sales
)
SELECT city, title, orders_count
FROM ranked
WHERE rn <= 5
ORDER BY orders_count DESC
LIMIT 5;


-- ============================================================
-- ЗАДАНИЕ 8. Оконные функции
-- ============================================================
SELECT
    b.title,
    b.price,
    AVG(b.price) OVER (PARTITION BY b.category_id) AS avg_category_price,
    b.price - AVG(b.price) OVER (PARTITION BY b.category_id) AS diff
FROM books b;


-- ============================================================
-- ЗАДАНИЕ 9. Ранжирование с RANK / DENSE_RANK
-- ============================================================
SELECT
    a.full_name,
    SUM(oi.quantity) AS total_sold,
    DENSE_RANK() OVER (ORDER BY SUM(oi.quantity) DESC) AS rank_position
FROM authors a
JOIN books b       ON b.author_id = a.id
JOIN order_items oi ON oi.book_id = b.id
GROUP BY a.id, a.full_name
ORDER BY rank_position
LIMIT 10;


-- ============================================================
-- ЗАДАНИЕ 10. Работа с датами
-- ============================================================
SELECT
    DATE_FORMAT(c.registration_date, '%Y-%m') AS month,
    COUNT(DISTINCT c.id) AS new_customers,
    COUNT(DISTINCT o.id) AS orders_within_30_days
FROM customers c
LEFT JOIN orders o
       ON o.customer_id = c.id
      AND o.order_date >= c.registration_date
      AND o.order_date <  DATE_ADD(c.registration_date, INTERVAL 30 DAY)
WHERE YEAR(c.registration_date) = 2025
GROUP BY DATE_FORMAT(c.registration_date, '%Y-%m')
ORDER BY month;


