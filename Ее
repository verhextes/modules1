-- ============================================================
-- ЗАДАНИЕ 19. Рекурсивный CTE (календарь)
-- ============================================================
WITH RECURSIVE calendar AS (
    SELECT DATE_FORMAT(CURDATE(), '%Y-%m-01') AS d
    UNION ALL
    SELECT DATE_ADD(d, INTERVAL 1 DAY)
    FROM calendar
    WHERE DATE_ADD(d, INTERVAL 1 DAY) < DATE_ADD(LAST_DAY(CURDATE()), INTERVAL 1 DAY)
)
SELECT
    c.d AS order_date,
    COUNT(o.id)                   AS orders_count,
    COALESCE(SUM(o.total_amount), 0) AS total_sum
FROM calendar c
LEFT JOIN orders o
       ON DATE(o.order_date) = c.d
GROUP BY c.d
ORDER BY c.d;


-- ============================================================
-- ЗАДАНИЕ 20. Комплексный аналитический запрос
-- ============================================================
WITH category_revenue AS (
    SELECT
        cat.id   AS category_id,
        cat.name AS category_name,
        SUM(oi.quantity * oi.unit_price) AS total_revenue
    FROM categories cat
    JOIN books b        ON b.category_id = cat.id
    JOIN order_items oi ON oi.book_id = b.id
    GROUP BY cat.id, cat.name
    ORDER BY total_revenue DESC
    LIMIT 3
),
author_sales AS (
    SELECT
        cat.id   AS category_id,
        a.id     AS author_id,
        a.full_name,
        SUM(oi.quantity) AS sold_quantity,
        ROW_NUMBER() OVER (
            PARTITION BY cat.id
            ORDER BY SUM(oi.quantity) DESC
        ) AS rn
    FROM categories cat
    JOIN books b        ON b.category_id = cat.id
    JOIN authors a      ON a.id = b.author_id
    JOIN order_items oi ON oi.book_id = b.id
    GROUP BY cat.id, a.id, a.full_name
)
SELECT
    cr.category_name,
    cr.total_revenue,
    ar.full_name       AS best_author,
    ar.sold_quantity   AS author_sold_in_category
FROM category_revenue cr
JOIN author_sales ar
       ON ar.category_id = cr.category_id
      AND ar.rn = 1
ORDER BY cr.total_revenue DESC;
