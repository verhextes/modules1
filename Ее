def think(me, world):
    enemies = world.get("enemies") or []
    if not enemies:
        return "forward"
    e = min(enemies, key=lambda z: abs(z["x"]-me["x"]) + abs(z["y"]-me["y"]))
    dx, dy = e["x"]-me["x"], e["y"]-me["y"]
    want = (0 if dx > 0 else 180) if abs(dx) >= abs(dy) else (90 if dy > 0 else 270)
    if me["angle"] != want:
        return "left" if (want - me["angle"]) % 360 in (90, 180) else "right"
    if me["cooldown"] <= 0:
        return "fire"
    if abs(dx) + abs(dy) > 6:
        return "forward"
    return "idle"
