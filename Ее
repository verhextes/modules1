-- ============================================================
-- ЗАДАНИЕ 14. Транзакции и целостность данных
-- ============================================================
START TRANSACTION;

-- 1. Уменьшаем остаток (с проверкой)
UPDATE books
SET stock = stock - 2
WHERE id = 1 AND stock >= 2;

-- если не обновилось ни одной строки — откат
-- (в клиенте проверить ROW_COUNT())
-- ROLLBACK при ROW_COUNT() = 0

-- 2. Создаём заказ
INSERT INTO orders (customer_id, order_date, status, total_amount)
VALUES (1, NOW(), 'new', 0);

SET @new_order_id = LAST_INSERT_ID();

-- 3. Добавляем позицию
INSERT INTO order_items (order_id, book_id, quantity, unit_price)
SELECT @new_order_id, id, 2, price
FROM books WHERE id = 1;

-- 4. Обновляем total_amount
UPDATE orders
SET total_amount = (
    SELECT SUM(quantity * unit_price)
    FROM order_items
    WHERE order_id = @new_order_id
)
WHERE id = @new_order_id;

COMMIT;
-- при ошибке на любом шаге: ROLLBACK;


-- ============================================================
-- ЗАДАНИЕ 15. Представления (VIEW)
-- ============================================================
CREATE OR REPLACE VIEW v_book_sales_stats AS
SELECT
    b.id,
    b.title,
    a.full_name  AS author,
    cat.name     AS category,
    b.price,
    COALESCE(SUM(oi.quantity), 0)                              AS total_sold,
    COALESCE(SUM(oi.quantity * oi.unit_price), 0)              AS total_revenue,
    COUNT(DISTINCT o.customer_id)                              AS unique_buyers
FROM books b
JOIN authors a      ON a.id = b.author_id
JOIN categories cat ON cat.id = b.category_id
LEFT JOIN order_items oi ON oi.book_id = b.id
LEFT JOIN orders o       ON o.id = oi.order_id
GROUP BY b.id, b.title, a.full_name, cat.name, b.price;

-- Топ-5 книг по выручке
SELECT *
FROM v_book_sales_stats
ORDER BY total_revenue DESC
LIMIT 5;


