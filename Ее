# Танчики · пишите стратегию здесь
# Каждый тик вызывается think(me, world) и должна вернуть команду.

def think(me, world):
    """
    me: x, y, angle (0/90/180/270), hp, energy, cooldown, alive
    world: enemies[{id,x,y,hp,angle}], boosters[{x,y,kind}],
           bullets[{x,y,owner_id}], width, height

    return: "forward" | "back" | "left" | "right" | "fire" | "idle"
    """
    # Пример: ехать вперёд и стрелять, если враг близко
    enemies = world.get("enemies") or []
    if enemies:
        e = enemies[0]
        dx = e["x"] - me["x"]
        dy = e["y"] - me["y"]
        if abs(dx) + abs(dy) < 8 and me["cooldown"] <= 0:
            return "fire"
    if me["energy"] > 5:
        return "forward"
    return "idle" 
