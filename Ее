DELIMITER $$

CREATE PROCEDURE GetCustomerOrderHistory(IN p_customer_id INT)
BEGIN
    -- Заказы клиента
    SELECT
        o.id           AS order_id,
        o.order_date,
        o.status,
        o.total_amount
    FROM orders o
    WHERE o.customer_id = p_customer_id
    ORDER BY o.order_date DESC;

    -- Книги по каждому заказу
    SELECT
        o.id           AS order_id,
        b.title,
        oi.quantity,
        oi.unit_price
    FROM orders o
    JOIN order_items oi ON oi.order_id = o.id
    JOIN books b        ON b.id = oi.book_id
    WHERE o.customer_id = p_customer_id
    ORDER BY o.id, b.title;
END$$

DELIMITER ;


-- ============================================================
-- ЗАДАНИЕ 17. Триггеры
-- ============================================================
DELIMITER $$

CREATE TRIGGER trg_order_items_after_insert
AFTER INSERT ON order_items
FOR EACH ROW
BEGIN
    DECLARE v_new_stock INT;

    -- 1. Уменьшаем stock
    UPDATE books
    SET stock = stock - NEW.quantity
    WHERE id = NEW.book_id;

    -- 2. Проверяем отрицательный остаток
    SELECT stock INTO v_new_stock
    FROM books
    WHERE id = NEW.book_id;

    IF v_new_stock < 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Недостаточно товара на складе';
    END IF;

    -- 3. Пересчитываем total_amount
    UPDATE orders
    SET total_amount = (
        SELECT SUM(quantity * unit_price)
        FROM order_items
        WHERE order_id = NEW.order_id
    )
    WHERE id = NEW.order_id;
END$$

DELIMITER ;


